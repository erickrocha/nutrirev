# Local .terraform directories
**/.terraform/*

# Terraform state files (remote state is used in prod; never commit local state)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Variable files likely to contain sensitive values
terraform.tfvars
*.auto.tfvars

# Saved plan files
*.tfplan
tfplan

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc
