# compose vars
DOMAIN=example.com
GHCR_OWNER=your-github-user

# backend (same names as backend/.env; no AWS/S3 needed with IMAGE_STORAGE_MODE=base64)
DATABASE_URL=mysql://USER:PASSWORD@SERVER:PORT/DATABASE_NAME
DATABASE_NAME=DATABASE_NAME
RUST_LOG=info
APP_ENV=production
IMAGE_STORAGE_MODE=S3
SYSADMIN_EMAIL=sysadmin@example.com
SYSADMIN_PASSWORD=SYSADMIN_PASSWORD
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
DEFAULT_PASSWORD=Default123!

# AWS / MinIO S3 Configuration
AWS_REGION=AWS_REGION
AWS_ACCESS_KEY_ID=AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=AWS_SECRET_ACCESS_KEY
AWS_S3_BUCKET=AWS_S3_BUCKET
AWS_SQS_QUEUE_URL=AWS_SQS_QUEUE_URL
# CloudFront Signed URL Configuration
CLOUDFRONT_DOMAIN=CLOUDFRONT_DOMAIN
CLOUDFRONT_KEY_PAIR_ID=CLOUDFRONT_KEY_PAIR_ID

CLAUDE_API_KEY=CLAUDE_API_KEY
CLAUDE_MODEL=claude-sonnet-5
# Only Claude is configured today; AI_FALLBACK_PROVIDER=none disables fallback to
# the other providers (gemini/openai/ollama) since they have no key configured.
GEMINI_API_KEY=GEMINI_API_KEY
GEMINI_MODEL=gemini-3-flash-preview
# Non-streaming Claude vision + JSON-generation calls routinely take 8-20s+;
# the code default of 15000ms is too tight and causes spurious "timed out" failures.
AI_PRIMARY_PROVIDER=claude
AI_FALLBACK_PROVIDER=none
AI_TIMEOUT_MS=45000

# e.Rede — credentials_secret_ref = "rede/clinic-a"
PAYMENT_SECRET_REDE_LAPIDATION_CLIENT_ID=PAYMENT_SECRET_REDE_LAPIDATION_CLIENT_ID
PAYMENT_SECRET_REDE_LAPIDATION_CLIENT_SECRET=PAYMENT_SECRET_REDE_LAPIDATION_CLIENT_SECRET
PAYMENT_ENVIRONMENT=sandbox
