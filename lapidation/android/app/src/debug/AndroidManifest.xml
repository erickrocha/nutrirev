<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Cleartext HTTP, for talking to a backend on the LAN during development.
         Debug only, and deliberately so: this app posts card numbers, and in the
         shipped manifest the platform's own block on plaintext traffic is the
         last line of defence if a build is ever misconfigured to an http:// URL.
         `tools:replace` is needed because the main manifest no longer sets it. -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
